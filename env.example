# panoramaTW-back 环境变量配置示例
# 复制此文件内容到你的环境变量配置中

# ========== 服务器配置 ==========
SERVER_PORT=8765
SPRING_PROFILES_ACTIVE=dev

# ========== MongoDB 配置 ==========
MONGODB_DATABASE=panoramaTW
MONGODB_AUTH_DATABASE=admin
MONGODB_URI=mongodb://localhost:27017/panoramaTW

# ========== PostgreSQL 数据源配置 ==========
DATASOURCE_URL=jdbc:postgresql://localhost:5432/panoramaTW
DATASOURCE_USERNAME=postgres
DATASOURCE_PASSWORD=your_password_here

# ========== 文件上传配置 ==========
MULTIPART_MAX_FILE_SIZE=1GB
MULTIPART_MAX_REQUEST_SIZE=1GB

# ========== 文件路径配置 ==========
# Windows 路径示例
PATH_TEMP=H:\data\nearshore\temp
PATH_RASTER_TILE=H:\data\nearshore\raster\rasterTile
PATH_RASTER_FILE=H:\data\nearshore\raster\rasterFile
PATH_STATIC=H:\data\nearshore\static
PATH_3DTILE=H:\data\nearshore\3DTile

# Linux/Mac 路径示例（注释掉上面的 Windows 路径，使用下面的）
# PATH_TEMP=/data/panoramaTW/temp
# PATH_RASTER_TILE=/data/panoramaTW/raster/rasterTile
# PATH_RASTER_FILE=/data/panoramaTW/raster/rasterFile
# PATH_STATIC=/data/panoramaTW/static
# PATH_3DTILE=/data/panoramaTW/3DTile

